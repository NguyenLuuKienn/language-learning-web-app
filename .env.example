# ==============================================================================
# Environment Configuration Template
# Sao chép file này thành .env và điền các giá trị phù hợp
# ==============================================================================

# Database Settings
MYSQL_ROOT_PASSWORD=root_password_123
MYSQL_DATABASE=language_learning_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password_123
MYSQL_PORT=3306

# Backend Configuration
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000
CONNECTION_STRING=Server=db;Port=3306;Database=language_learning_db;User=app_user;Password=app_password_123;TreatTinyAsBoolean=true;

# JWT Authentication
JWT_SECRET_KEY=super_secret_jwt_key_at_least_32_characters_long_12345
JWT_ISSUER=LanguageLearningApp
JWT_AUDIENCE=LanguageLearningAppClient
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:5000/api/v1
